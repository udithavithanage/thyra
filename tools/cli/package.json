{
  "name": "thyra",
  "version": "1.3.1",
  "description": "Simple project folder opener CLI",
  "type": "module",
  "bin": {
    "thyra": "dist/index.js"
  },
  "scripts": {
    "build": "bunup --clean",
    "link": "bun run build && bun link",
    "unlink": "bun unlink",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "cli",
    "projects",
    "folders",
    "shortcut",
    "vscode"
  ],
  "author": "Uditha Vithanage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udithavithanage/thyra.git"
  },
  "bugs": {
    "url": "https://github.com/udithavithanage/thyra/issues"
  },
  "homepage": "https://github.com/udithavithanage/thyra#readme",
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "bunup": "^0.16.32"
  },
  "peerDependencies": {}
}
